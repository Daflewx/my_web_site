{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Запустить сайт",
      "type": "process",
      "command": "node",
      "args": ["scripts/server.js"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" },
      "runOptions": { "instanceLimit": 1 }
    },
    {
      "label": "Запустить сайт для телефона (Wi-Fi)",
      "type": "process",
      "command": "node",
      "args": ["scripts/server.js", "--host"],
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" },
      "runOptions": { "instanceLimit": 1 }
    }
  ]
}
